{
  "name": "@nono-ui",
  "version": "0.3.0",
  "description": "Librería personal de componentes Vue con Reka UI y Tailwind CSS",
  "keywords": [
    "nono-ui",
    "vue"
  ],
  "homepage": "https://github.com/nono-cn/nono-ui#readme",
  "bugs": {
    "url": "https://github.com/nono-cn/nono-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nono-cn/nono-ui.git"
  },
  "license": "ISC",
  "author": "José Antonio Navas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "import": "./dist/components/ui/*/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./assets/icons": {
      "types": "./dist/assets/icons/index.d.ts",
      "import": "./dist/assets/icons/index.js"
    },
    "./components/provider": {
      "types": "./dist/components/provider/index.d.ts",
      "import": "./dist/components/provider/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "files": [
    "bin",
    "dist",
    "scripts"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.ts",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build": "vite build",
    "build:docs": "vite build --config vite.docs.config.ts",
    "preview": "vite preview --config vite.docs.config.ts",
    "preview:docs": "vite preview --config vite.docs.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "cli": "node ./bin/nono-ui.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/vue": "^1.25.0",
    "@unovis/ts": "1.6.7",
    "@unovis/vue": "1.6.7",
    "@vue/shared": "^3.5.39",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.5.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "module": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "nono-ui": "./bin/nono-ui.mjs"
  }
}
